{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["**/components/ui/**", "**/dist/**"],
    "rules": ["react-doctor/js-set-map-lookups"],
    "overrides": [
      {
        "files": ["src/atom.ts", "src/components/craft/UpdateModal/atom.ts"],
        "rules": ["react-doctor/jotai-derived-atom-returns-fresh-object"]
      },
      {
        "files": ["src/routes/contexts/Server.Context.ts"],
        "rules": ["react-doctor/query-mutation-missing-invalidation"]
      },
      {
        "files": [
          "src/components/craft/library/ContentCard.tsx",
          "src/components/craft/library/GroupCard.tsx"
        ],
        "rules": [
          "react-doctor/click-events-have-key-events",
          "react-doctor/no-noninteractive-element-interactions"
        ]
      }
    ]
  }
}
